import ../RCamera;
import ../CVar;

import ../interop;

RCameraInfo gSavedCameraInfo;

bool bDidEnter = false;

void BrightenCamera()
{
	SetCVar<float>("r_shutter", 1.0 / 40.0f);
}

void object_trigger_enter(OBJECT trigger)
{
	float3 dir = trigger.enter_direction;

	if (bDidEnter) {
		gSavedCameraInfo.Fetch();
		printf("EXIT\n");
	}
	else {
		gSavedCameraInfo.Apply();
		BrightenCamera();
		printf("ENTER\n");
	}

	bDidEnter = !bDidEnter;
}


void object_trigger_exit(OBJECT trigger)
{
}
