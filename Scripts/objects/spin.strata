/*
 * File:        spin.strata
 * Author:      emd22
 * Created:     07/10/2026
 * Description: Example object script. Attach it to an object from the Script field of the editor's properties panel.
 *              Turns the object about its yaw axis while the game is running, and puts it back when the game stops.
 */

import ../interop;
import ../RObject;

import std/mathconsts;


/* Every object a script is attached to runs its own copy of the script, so these globals belong to that object. */
const float gcSpinSpeed = ((90.0f * F_PI) / 180.0f);

float3 gInitialRotation;
float gSpinAngle = 0.0f;

/* Called on the first frame the object is simulated. */
void ObjectBegin(RObject obj)
{
	gInitialRotation = obj.GetRotationEuler();
	gSpinAngle = 0.0f;
}

/* Called every simulated frame. */
void ObjectTick(RObject obj, float delta_time)
{
	gSpinAngle += delta_time * gcSpinSpeed;

	const float3 new_angle = gInitialRotation + float3(0.0f, gSpinAngle, 0.0f);
	obj.RotateToEuler(new_angle);
}

/* Called when simulation ends and the editor goes back to editing. */
void ObjectStop(RObject obj)
{
	obj.RotateToEuler(gInitialRotation);
}
