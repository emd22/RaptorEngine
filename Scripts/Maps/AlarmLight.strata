
import ../RLight;
import ../RObject;
import ../RColor;

import ../math;

import std/mathconsts;

extern int printf(cstring fmt, ...);

/* */

const float gcSpinSpeed = ((90.0f * F_PI) / 180.0f);

RLightSpot gLight;

float gTime = 0.0f;


void ObjectBegin(RObject obj)
{
	gLight = RLightSpot.Create("AlarmLight", ((uint)RLightFlags.Dynamic | (uint)RLightFlags.Persistent));
	gLight.SetPosition(float3(0.0f));
	gLight.SetRadius(30.0f);

	gLight.SetColor(RColorValue.FromRGBA(255, 100, 100, 255));

	printf("Creating light\n");
}

void ObjectTick(RObject obj, float delta_time)
{
	gTime += delta_time * 2.5f;
	if (gTime > F_2PI) {
		gTime = 0.0f;
	}

	const float3 direction = float3(cosf(gTime), 0.0f, sinf(gTime));

	gLight.SetDirection(direction);
}



void ObjectStop(RObject obj)
{
	gLight.Destroy();
}
