 * Description: This script serves as a one-stop shop for all object transformations in-game.
 */

import ../interop;
import ../common;
import ../keyboard;


enum OBJECTTAG
{
	BLOCKOUT = (1 << 0),
}

enum XFORMTYPE
{
	TRANSLATE = 0,
	FACE = 1,
}

const int LIMIT_SELECTION_OBJECTS = 64;

struct SELECTION
{
	/* The currently selected object (via raycast) */
	OBJECT selected_object;

	OBJECT[LIMIT_SELECTION_OBJECTS] selected_objects;
	float3[LIMIT_SELECTION_OBJECTS] initial_object_positions;
	int selected_objects_count;

	/* Selected cube face (for FACE mode) */

	float3 selected_face;
	float selected_face_scale;
};

/////////////////////////////////////
// Globals
/////////////////////////////////////

float3 initial_player_position;
bool mouse_is_dragging = false;
bool mouse_was_in_drag_event = false;

/* snap */
int editor_snap_level = 2;
bool editor_enable_snap = true;

bool player_had_headbob = false;

/* Cube marker used for showing distance and movement when transforming an object.
   Used mainly with scale/face tool. */
OBJECT transform_marker_object;

/* Empty object */
OBJECT null_object;

SELECTION sel;

float3 face_tool_magnitude;

XFORMTYPE transform_type = XFORMTYPE.TRANSLATE;



/////////////////////////////////////
// Editor functions
/////////////////////////////////////

@private
void reset_selection()
{
	sel.selected_face = float3(0.0f);
	sel.selected_face_scale = 0.0f;
	sel.selected_objects_count = 0;
}

void hide_transform_marker_object()
{
	/* Move the transform marker to a location where the user won't see it... */
	transform_marker_object.move_to(float3(200.0f));
}

/* Adjust the step size of the snap. negative (-1) decreases the size of each step,
   positive (1) increases it. */
@private
void editor_adjust_snap_index(int direction)
{
	if (direction < 0) {
		editor_snap_level--;
	}
	else {
		editor_snap_level++;
	}

	editor_snap_level = fclamp(editor_snap_level, 0, 3);
}

@private
bool editor_has_object_selection()
{
	return (sel.selected_objects_count > 0);
}


/* DO NOT USE NORMALLY, this is meant to be called by the C++ side. */
void _internal_editor_select_object(OBJECT object, bool is_selected, bool append_selection)
{
	sel.selected_object = object;

	if (is_selected && append_selection) {
		// Ignore if we are above the current selection count
		if (sel.selected_objects_count >= LIMIT_SELECTION_OBJECTS) {
			script_error("object cannot be selected as selection is too large");
			return;
		}

		sel.selected_objects[sel.selected_objects_count++] = object;
		return;
	}

	// We have selected an object, but will not append to the current selection.
	if (is_selected) {
		sel.selected_objects[0] = object;
		sel.selected_objects_count = 1;
	}
	// Clear the current selection
	else {
		sel.selected_objects_count = 0;
	}
}

/* Select an object. Passing in false for `is_selected` acts as a null value, voiding the selection. */
void editor_select_object(OBJECT object, bool is_selected, bool append_selection)
{
	// NOTE: this calls the C++ function `_select_object_internal` that will internally call
	// `_internal_editor_select_object`.

 	object._select_object_internal(is_selected, append_selection);
}


/* Destroy all objects in the selection. */
@private
void editor_destroy_selection()
{
	for (int i = 0; i < sel.selected_objects_count; i++) {
		blockout_destroy_object(sel.selected_objects[i]);
	}

	reset_selection();
}

@private
void editor_dupe_selection()
{
	int tmp_num_selected_objects = sel.selected_objects_count;

	// To properly dupe the selection, we need the original materials.
	{
		// This is kind of janky, but we need to deselect our full selection; to revert back from the
		// selection material. the selected objects as we still need to dupe them though, so save the
		// currently selected object count to revert back to after.

		// Deselect the objects / zero out the selected_objects count.
		editor_select_object(null_object, false, false);
	}

	// Now that the materials are back to their original states, dupe the objects.
	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT object_to_dupe = sel.selected_objects[i];

		OBJECT dupe = blockout_dupe_object(object_to_dupe);

		// Replace the selected object with the dupe. We are overwriting the previous selection
		// and essentially using `selected_objects` as a temp buffer.
		sel.selected_objects[i] = dupe;

		// Move the dupe to the position of the duped object
		dupe.move_to(object_to_dupe.get_position());
	}

	// Back to material shit. The C++ side doesn't know about the selected objects yet, and we need to
	// assign them to have the selection material.
	{
		for (int i = 0; i < tmp_num_selected_objects; i++) {
			// Append the selection from the new object handles.
			editor_select_object(sel.selected_objects[i], true, true);
		}
	}
}

@private
void editor_handle_controls()
{
	if (KEY.K_U.is_pressed()) {
		editor_enable_snap = !editor_enable_snap;
	}

	if (KEY.K_MINUS.is_pressed()) {
		editor_adjust_snap_index(-1);
	}
	if (KEY.K_EQUALS.is_pressed()) {
		editor_adjust_snap_index(1);
	}

	const bool not_in_xform_operation = (!mouse_is_dragging);

	/* Do not allow changing modes (or creating new objects) while actively doing an editor task */
	if (not_in_xform_operation) {
		/* Create a new blockout object */
		if (KEY.K_K.is_pressed()) {
			float3 origin = player.ray_get_point(20.0f);
			OBJECT new_obj = blockout_new_object(origin);
			editor_select_object(new_obj, true, false);
		}

		/* Transform type selectors */

		/* Translate (Move) */
		if (KEY.K_T.is_pressed()) {
			cvar_set_string("s_editor_op", "Translate");
			transform_type = XFORMTYPE.TRANSLATE;
		}

		/* Face (Scale) */
		if (KEY.K_F.is_pressed()) {
			cvar_set_string("s_editor_op", "Face");
			transform_type = XFORMTYPE.FACE;
		}
	}

	/* Non-manipulation, but object functions. */
	if (editor_has_object_selection()) {
		/* Destroy/Remove an object */
		if (KEY.K_BACKSPACE.is_pressed()) {
			editor_destroy_selection();
		}

		/* Dupe object on LCTRL + D */
		if (KEY.K_D.is_lctrl_combo()) {
			editor_dupe_selection();
		}

	}


	mouse_is_dragging = KEY.K_MOUSE_LEFT.is_down();
}


/* Get the division that we are quantizing by. NOTE: not the index. */
float editor_get_snap_value()
{
	float[4] snap_values = { 0.05f, 0.10f, 0.25f, 0.50f };
	uint index = fclamp(editor_snap_level, 0, 3);
	return snap_values[index];
}

bool editor_get_snap_enabled()
{
	return editor_enable_snap;
}

/* If snap is enabled, this snaps a given vector to the selected snap fraction. */
float3 editor_transform_snap(float3 vec)
{
	if (!editor_enable_snap) {
		return vec;
	}

	float3 qsnap = float3(editor_get_snap_value());
	return (float3_round(vec / qsnap) * qsnap);
}


/* Player movement dampening */

void editor_enable_movement_damp()
{
	player.set_speed_multiplier(0.5f);
	cvar_set_bool("b_headbob_enabled", false);
}

void editor_disable_movement_damp()
{
	player.set_speed_multiplier(1.0f);
	cvar_set_bool("b_headbob_enabled", player_had_headbob);
}


/* The mouse button was pressed with no ongoing mouse down event. */
void editor_on_mouse_just_down()
{
	initial_player_position = player.position;


	for (int i = 0; i < sel.selected_objects_count; i++) {
		sel.initial_object_positions[i] = sel.selected_objects[i].position;
	}

	// initial_object_position = sel.selected_object.position;
	mouse_was_in_drag_event = true;


	if (transform_type == XFORMTYPE.FACE) {
		/* Cast and gather the face we are pointing towards */
		float3 selected_face = sel.selected_object.ray_get_face();

		sel.selected_face = selected_face;
		sel.selected_face_scale = sel.selected_object.direction_scale(selected_face);
	}
}


/////////////////////////////////////
// Translate Tool
/////////////////////////////////////

@private
void editor_move_selection(float3 movement_delta)
{
	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT obj = sel.selected_objects[i];

		// float3 start_position = obj.get_position();
		float3 initial_position = sel.initial_object_positions[i];

		obj.move_to((initial_position + movement_delta));
	}

}

/* Translate an object */
@private
void editor_translate_tool(float delta_time)
{
	if (!editor_has_object_selection()) {
		return;
	}

	float3 translate_movement = player.position - initial_player_position;

	/* We are not in fly mode, handle Z movement manually */
	if (!player.is_flymode()) {
		const float speed = delta_time * 2.0f;

		if (KEY.K_Q.is_down()) {
			float3 move_direction = float3(0.0f, speed, 0.0f);
			translate_movement += move_direction;
			initial_player_position += move_direction;
		}
		if (KEY.K_E.is_down()) {
			float3 move_direction = float3(0.0f, -speed, 0.0f);
			translate_movement += move_direction;
			initial_player_position += move_direction;
		}
	}

	float3 movement_delta = editor_transform_snap(translate_movement);

	editor_move_selection(movement_delta);
}

/////////////////////////////////////
// Face Tool
/////////////////////////////////////

enum FACEDIR
{
	X = 0,
	Y = 1,
	Z = 2,
};

@private
FACEDIR face_get_dir()
{
	float3 abs_face = float3_abs(sel.selected_face);

	const float threshold = 0.01f;

	if (abs_face.x > threshold) {
		return FACEDIR.X;
	}
	if (abs_face.y > threshold) {
		return FACEDIR.Y;
	}

	return FACEDIR.Z;
}


@private
void editor_face_tool(float delta_time)
{
	FACEDIR direction = face_get_dir();

	face_tool_magnitude = editor_transform_snap(player.position - initial_player_position) * sel.selected_face;

	float3 player_pos = player.position;

	float3 destination_position = editor_transform_snap(player_pos - initial_player_position);
	float3 camera_pos = camera_position();

	if (direction == FACEDIR.X) {
		destination_position.y = camera_pos.y;
		destination_position.z = player_pos.z;
	}
	else if (direction == FACEDIR.Y) {
		destination_position.x = player_pos.x;
		destination_position.z = player_pos.z;
	}
	else if (direction == FACEDIR.Z) {
		destination_position.y = camera_pos.y;
		destination_position.x = player_pos.x;
	}

	/* Calculate the position for the transform marker */
	float3 xform_marker_dest = (destination_position + (sel.selected_face * float3(sel.selected_face_scale)));
	transform_marker_object.move_to(xform_marker_dest);
}

@private
void editor_face_tool_finalize()
{
	bool has_selection = editor_has_object_selection();

	hide_transform_marker_object();

	if (!has_selection) {
		return;
	}

	for (int i = 0; i < sel.selected_objects_count; i++) {
		blockout_object_scale(
			sel.selected_objects[i],
			sel.selected_face,
			face_tool_magnitude
		);

		blockout_reload_object(sel.selected_objects[i]);
	}

}


/////////////////////////////////////
// Editor Dispatch
/////////////////////////////////////

@private
void editor_handle_operation(float delta_time)
{
	if (transform_type == XFORMTYPE.TRANSLATE) {
		editor_translate_tool(delta_time);
		return;
	}
	if (transform_type == XFORMTYPE.FACE) {
		editor_face_tool(delta_time);
		return;
	}
}


@private
void editor_finalize_operation()
{
	/* Finalize the scale operation */
	if (transform_type == XFORMTYPE.FACE) {
		editor_face_tool_finalize();
	}
}



/////////////////////////////////////
// Interface Functions
/////////////////////////////////////

/* Called when switching into the editor mode */
void mode_load()
{
	reset_selection();

	player_had_headbob = cvar_get_bool("b_headbob_enabled", false);
}

/* Called when switching out of editor mode */
void mode_unload()
{
	reset_selection();
	hide_transform_marker_object();

	editor_disable_movement_damp();

	cvar_set_string("s_editor_op", "None");
}

void editor_set_transform_marker(OBJECT xform_marker)
{
	transform_marker_object = xform_marker;
}


void mode_update(float3 movement_vector, float delta_time)
{
	editor_handle_controls();

	if (mouse_was_in_drag_event && !mouse_is_dragging) {
		editor_finalize_operation();
	}

	/* Mouse is no longer down, do not perform any operations */
	if (!editor_has_object_selection() || !mouse_is_dragging) {
		editor_disable_movement_damp();
		mouse_was_in_drag_event = false;
		return;
	}

	editor_enable_movement_damp();

	if (mouse_was_in_drag_event == false) {
		editor_on_mouse_just_down();
	}

	editor_handle_operation(delta_time);
}


/////////////////////////////////////
// Commands
/////////////////////////////////////


/* Snap selected object to world */
void CMD_snap2w()
{
	if (!editor_has_object_selection()) {
		return;
	}

	// Snap all objects to world grid
	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT obj = sel.selected_objects[i];
		obj.move_to(editor_transform_snap(obj.position));
	}
}
