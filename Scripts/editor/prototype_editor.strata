import ../interop;
import ../common;
import ../keyboard;


enum OBJECTTAG
{
	BLOCKOUT = (1 << 0),
}


const int LIMIT_SELECTION_OBJECTS = 64;

struct SELECTION
{
	/* The currently selected object (via raycast) */
	OBJECT selected_object;

	OBJECT[LIMIT_SELECTION_OBJECTS] selected_objects;
	float3[LIMIT_SELECTION_OBJECTS] initial_object_positions;
	float3[LIMIT_SELECTION_OBJECTS] initial_object_rotations;
	int selected_objects_count;

	/* Selected cube face (for FACE mode) */

	float3 selected_face;
	float selected_face_scale;
};

/////////////////////////////////////
// Globals
/////////////////////////////////////

float3 initial_player_position;
bool mouse_is_dragging = false;
bool mouse_was_in_drag_event = false;

/* snap */
int editor_snap_level = 2;
bool editor_enable_snap = true;

bool player_had_headbob = false;

/* Cube marker used for showing distance and movement when transforming an object.
   Used mainly with scale/face tool. */
OBJECT transform_marker_object;

/* Empty object */
OBJECT null_object;

SELECTION sel;

float3 face_tool_magnitude;
float3 initial_face_object_position;
float3 initial_face_position;
float3 face_world_normal;
float face_min_proj;

/* Matches scMinBlockoutThickness in Blockout.cpp */
const float FACE_MIN_THICKNESS = 0.25f;

/* Accumulated Q/E pitch for the Rotate tool, reset at the start of each drag */
float rotate_pitch_accum = 0.0f;

/* Accumulated Q/E height for the Translate tool, reset at the start of each drag */
float translate_height_accum = 0.0f;

EDITORTOOL editor_tool = EDITORTOOL.TRANSLATE;



/////////////////////////////////////
// Editor functions
/////////////////////////////////////


void hide_transform_marker_object()
{
	/* Move the transform marker to a location where the user won't see it... */
	transform_marker_object.move_to(float3(200.0f));
}

/* Adjust the step size of the snap. negative (-1) decreases the size of each step,
   positive (1) increases it. */
@private
void editor_adjust_snap_index(int direction)
{
	if (direction < 0) {
		editor_snap_level--;
	}
	else {
		editor_snap_level++;
	}

	editor_snap_level = fclamp(editor_snap_level, 0, 3);
}

@private
bool editor_has_object_selection()
{
	return (sel.selected_objects_count > 0);
}


/* DO NOT USE NORMALLY, this is meant to be called by the C++ side. */
void _internal_editor_select_object(OBJECT object, bool is_selected, bool append_selection)
{
	sel.selected_object = object;

	if (is_selected && append_selection) {
		// Ignore if we are above the current selection count
		if (sel.selected_objects_count >= LIMIT_SELECTION_OBJECTS) {
			script_error("object cannot be selected as selection is too large");
			return;
		}

		sel.selected_objects[sel.selected_objects_count++] = object;
		return;
	}

	// We have selected an object, but will not append to the current selection.
	if (is_selected) {
		sel.selected_objects[0] = object;
		sel.selected_objects_count = 1;
	}
	// Clear the current selection
	else {
		sel.selected_objects_count = 0;
	}
}

/* Select an object. Passing in false for `is_selected` acts as a null value, voiding the selection. */
void editor_select_object(OBJECT object, bool is_selected, bool append_selection)
{
	// NOTE: this calls the C++ function `_select_object_internal` that will internally call
	// `_internal_editor_select_object`.

 	object._select_object_internal(is_selected, append_selection);
}


@private
void reset_selection()
{
	sel.selected_face = float3(0.0f);
	sel.selected_face_scale = 0.0f;

	editor_select_object(null_object, false, false);
}


/* Destroy all objects in the selection. Pushing the Delete op destroys each
   object immediately (via Execute) and records the snapshot for undo. */
@private
void editor_destroy_selection()
{
	int count = sel.selected_objects_count;

	for (int i = 0; i < count; i++) {
		editor_push_op_delete(sel.selected_objects[i], count);
	}

	reset_selection();
}

@private
void editor_dupe_selection()
{
	int n = sel.selected_objects_count;

	// Push the Dupe op for each original. Execute creates the dupe with the
	// original (unselected) material, so no deselect dance is needed. Reuse
	// `selected_objects` as a temp buffer for the new handles.
	for (int i = 0; i < n; i++) {
		OBJECT object_to_dupe = sel.selected_objects[i];

		// OBJECT dupe = editor_push_op_obj(object_to_dupe, OPTYPE.DUPE, object_to_dupe, null_object, n);

		OBJECT dupe = editor_op_dupe_object(object_to_dupe, object_to_dupe.position, n);

		// Replace the selected object with the dupe. We are overwriting the previous selection
		// and essentially using `selected_objects` as a temp buffer.
		sel.selected_objects[i] = dupe;
	}

	// Swap the selection over to the dupes. The null-select restores the
	// originals' materials on the C++ side; the appends select the dupes.
	editor_select_object(null_object, false, false);

	{
		for (int i = 0; i < n; i++) {
			// Append the selection from the new object handles.
			editor_select_object(sel.selected_objects[i], true, true);
		}
	}
}

void __set_editor_tool(EDITORTOOL tool)
{
	if (tool == EDITORTOOL.TRANSLATE) {
		cvar_set_string("s_editor_op", "Translate");
	}
	else if (tool == EDITORTOOL.FACE) {
		cvar_set_string("s_editor_op", "Face");
	}
	else if (tool == EDITORTOOL.ROTATE) {
		cvar_set_string("s_editor_op", "Rotate");
	}

	editor_tool = tool;
}

void set_editor_tool(EDITORTOOL tool)
{
	GUI_set_editor_tool(tool);
	// __set_editor_tool() is called by the GUI editor
}

@private
void editor_handle_controls()
{
	if (KEY.K_U.is_pressed()) {
		editor_enable_snap = !editor_enable_snap;
	}

	if (KEY.K_MINUS.is_pressed()) {
		editor_adjust_snap_index(-1);
	}
	if (KEY.K_EQUALS.is_pressed()) {
		editor_adjust_snap_index(1);
	}

	const bool not_in_xform_operation = (!mouse_is_dragging);

	/* Do not allow changing modes (or creating new objects) while actively doing an editor task */
	if (not_in_xform_operation) {
		/* Create a new blockout object */
		if (KEY.K_K.is_pressed()) {
			float3 origin = editor_transform_snap(player.ray_get_point(20.0f));
			// OBJECT new_obj = blockout_new_object(editor_transform_snap(origin));

			OBJECT new_obj = editor_op_create_object(origin, 1);

			editor_select_object(new_obj, true, false);
		}

		/* Transform type selectors */

		/* Translate (Move) */
		if (KEY.K_T.is_pressed()) {
			set_editor_tool(EDITORTOOL.TRANSLATE);
		}

		/* Face (Scale) */
		if (KEY.K_F.is_pressed()) {
			set_editor_tool(EDITORTOOL.FACE);
		}

		/* Rotate. Excludes LSHIFT so this doesn't also fire on the C++ side's Shift+R (reload blockout). */
		if (KEY.K_R.is_pressed() && !KEY.K_LSHIFT.is_down()) {
			set_editor_tool(EDITORTOOL.ROTATE);
		}
	}

	if (editor_tool == EDITORTOOL.FACE && not_in_xform_operation) {
		editor_face_texture_controls();
	}

	/* Non-manipulation, but object functions. */
	if (editor_has_object_selection()) {
		/* Destroy/Remove an object */
		if (KEY.K_BACKSPACE.is_pressed()) {
			editor_destroy_selection();
		}

		/* Dupe object on LCTRL + D */
		if (KEY.K_D.is_lctrl_combo()) {
			editor_dupe_selection();
		}

	}


	mouse_is_dragging = KEY.K_MOUSE_LEFT.is_down();
}


/* Get the division that we are quantizing by. NOTE: not the index. */
float editor_get_snap_value()
{
	float[4] snap_values = { 0.05f, 0.10f, 0.25f, 0.50f };
	uint index = fclamp(editor_snap_level, 0, 3);
	return snap_values[index];
}

bool editor_get_snap_enabled()
{
	return editor_enable_snap;
}

/* If snap is enabled, this snaps a given vector to the selected snap fraction. */
float3 editor_transform_snap(float3 vec)
{
	if (!editor_enable_snap) {
		return vec;
	}

	float3 qsnap = float3(editor_get_snap_value());
	return (float3_round(vec / qsnap) * qsnap);
}

/* Epsilon helpers for skipping no-op undo pushes (a click without movement). */
@private
bool editor_vec_is_zero(float3 v)
{
	const float eps = 0.00001f;
	return (v.x < eps && v.x > -eps) && (v.y < eps && v.y > -eps) && (v.z < eps && v.z > -eps);
}

@private
bool editor_vec_equal(float3 a, float3 b)
{
	return editor_vec_is_zero(a - b);
}


/* Player movement dampening */

void editor_enable_movement_damp()
{
	player.set_speed_multiplier(0.5f);
	cvar_set_bool("b_headbob_enabled", false);
}

void editor_disable_movement_damp()
{
	player.set_speed_multiplier(1.0f);
	cvar_set_bool("b_headbob_enabled", player_had_headbob);
}


/* The mouse button was pressed with no ongoing mouse down event. */
void editor_on_mouse_just_down()
{
	initial_player_position = player.position;
	rotate_pitch_accum = 0.0f;
	translate_height_accum = 0.0f;


	for (int i = 0; i < sel.selected_objects_count; i++) {
		sel.initial_object_positions[i] = sel.selected_objects[i].position;
		sel.initial_object_rotations[i] = sel.selected_objects[i].get_rotation();
	}

	// initial_object_position = sel.selected_object.position;
	mouse_was_in_drag_event = true;


	if (editor_tool == EDITORTOOL.FACE) {
		/* Cast and gather the face we are pointing towards */
		float3 selected_face = sel.selected_object.ray_get_face();

		sel.selected_face = selected_face;
		sel.selected_face_scale = sel.selected_object.direction_scale(selected_face);

		/* Snapshot where the face is now so the preview marker can track
		   exactly where it will be after finalize (obj pos + face offset). */
		initial_face_object_position = sel.selected_object.position;
		initial_face_position = sel.selected_object.local_to_world(blockout_face_center(sel.selected_object, selected_face));
		face_world_normal = sel.selected_object.local_dir_to_world(selected_face);

		float thickness = sel.selected_face_scale + sel.selected_object.direction_scale(float3(0.0f) - selected_face);
		face_min_proj = fmin(0.0f, FACE_MIN_THICKNESS - thickness);
	}
}


/////////////////////////////////////
// Translate Tool
/////////////////////////////////////

@private
void editor_move_selection(float3 movement_delta)
{
	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT obj = sel.selected_objects[i];

		// float3 start_position = obj.get_position();
		float3 initial_position = sel.initial_object_positions[i];

		obj.move_to((initial_position + movement_delta));
	}

}

/* Translate an object */
@private
void editor_translate_tool(float delta_time)
{
	if (!editor_has_object_selection()) {
		return;
	}

	/* Only the player's X/Z movement drags the selection, so looking around or flying doesn't change its height. Height
	   comes from Q/E alone (same directions as flying: E up, Q down). */
	float3 player_delta = player.position - initial_player_position;

	const float speed = delta_time * (editor_get_snap_value() * 8.0);

	if (KEY.K_E.is_down()) {
		translate_height_accum += speed;
	}
	if (KEY.K_Q.is_down()) {
		translate_height_accum -= speed;
	}

	float3 translate_movement = float3(player_delta.x, translate_height_accum, player_delta.z);

	float3 movement_delta = editor_transform_snap(translate_movement);

	editor_move_selection(movement_delta);
}


@private
void editor_translate_tool_finalize()
{
	// Skip clicks without movement so we don't burn undo history on no-ops.
	// GroupSize must match the pushed op count exactly for multi-undo.
	int movers = 0;
	for (int i = 0; i < sel.selected_objects_count; i++) {
		if (!editor_vec_equal(sel.initial_object_positions[i], sel.selected_objects[i].position)) {
			movers++;
		}
	}

	if (movers == 0) {
		return;
	}

	// Log movements for undo
	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT obj = sel.selected_objects[i];

		float3 initial_position = sel.initial_object_positions[i];

		if (editor_vec_equal(initial_position, obj.position)) {
			continue;
		}

		editor_push_op_vec(obj, OPTYPE.MOVE, initial_position, obj.position, movers);
	}
}

/////////////////////////////////////
// Face Tool
/////////////////////////////////////

enum FACEDIR
{
	X = 0,
	Y = 1,
	Z = 2,
};

@private
FACEDIR face_get_dir()
{
	float3 abs_face = float3_abs(sel.selected_face);

	const float threshold = 0.01f;

	if (abs_face.x > threshold) {
		return FACEDIR.X;
	}
	if (abs_face.y > threshold) {
		return FACEDIR.Y;
	}

	return FACEDIR.Z;
}


@private
void editor_face_tool(float delta_time)
{
	/* Player delta projected onto the face's world normal. Follows
	   Blockout::ScaleInDirection (Max += mag / Min -= mag). */
	float3 snapped = editor_transform_snap(float3(dot(player.position - initial_player_position, face_world_normal)));
	float proj = fmax(snapped.x, face_min_proj);

	face_tool_magnitude = float3(proj);

	float3 xform_marker_dest = initial_face_position + (face_world_normal * float3(proj));
	transform_marker_object.move_to(xform_marker_dest);
}

/* Degrees the texture on a face turns per key press */
const float FACE_TEXTURE_ROTATE_STEP = 15.0f;

/* Scale applied to the texture on a face per key press */
const float FACE_TEXTURE_SCALE_STEP = 2.0f;

/* Edits the texture on the face of the selected object under the crosshair:
   arrows shift it, [ and ] scale it, , and . rotate it, M cycles its material and J resets it. */
@private
void editor_face_texture_controls()
{
	if (!editor_has_object_selection()) {
		return;
	}

	OBJECT obj = sel.selected_object;
	float3 face = obj.ray_get_face();

	if (editor_vec_is_zero(face)) {
		return;
	}

	/* Shift by the current snap size, in texture repeats */
	float step = editor_get_snap_value();

	if (KEY.K_LEFT.is_pressed()) {
		blockout_edit_face_texture(obj, face, FACETEXTUREEDIT.SHIFT, float3(0.0f - step, 0.0f, 0.0f));
	}
	if (KEY.K_RIGHT.is_pressed()) {
		blockout_edit_face_texture(obj, face, FACETEXTUREEDIT.SHIFT, float3(step, 0.0f, 0.0f));
	}
	if (KEY.K_UP.is_pressed()) {
		blockout_edit_face_texture(obj, face, FACETEXTUREEDIT.SHIFT, float3(0.0f, 0.0f - step, 0.0f));
	}
	if (KEY.K_DOWN.is_pressed()) {
		blockout_edit_face_texture(obj, face, FACETEXTUREEDIT.SHIFT, float3(0.0f, step, 0.0f));
	}

	if (KEY.K_LBRACKET.is_pressed()) {
		float shrink = 1.0f / FACE_TEXTURE_SCALE_STEP;
		blockout_edit_face_texture(obj, face, FACETEXTUREEDIT.SCALE, float3(shrink, shrink, 0.0f));
	}
	if (KEY.K_RBRACKET.is_pressed()) {
		blockout_edit_face_texture(obj, face, FACETEXTUREEDIT.SCALE,
								   float3(FACE_TEXTURE_SCALE_STEP, FACE_TEXTURE_SCALE_STEP, 0.0f));
	}

	if (KEY.K_COMMA.is_pressed()) {
		blockout_edit_face_texture(obj, face, FACETEXTUREEDIT.ROTATE, float3(0.0f - FACE_TEXTURE_ROTATE_STEP));
	}
	if (KEY.K_PERIOD.is_pressed()) {
		blockout_edit_face_texture(obj, face, FACETEXTUREEDIT.ROTATE, float3(FACE_TEXTURE_ROTATE_STEP));
	}

	if (KEY.K_M.is_pressed()) {
		blockout_edit_face_texture(obj, face, FACETEXTUREEDIT.CYCLE_MATERIAL, float3(0.0f));
	}
	if (KEY.K_J.is_pressed()) {
		blockout_edit_face_texture(obj, face, FACETEXTUREEDIT.RESET, float3(0.0f));
	}
}

@private
void editor_face_tool_finalize()
{
	bool has_selection = editor_has_object_selection();

	hide_transform_marker_object();

	if (!has_selection) {
		return;
	}

	// A click without drag leaves a zero magnitude; pushing it would burn
	// undo history on a no-op and split nothing, so skip it.
	if (editor_vec_is_zero(face_tool_magnitude)) {
		return;
	}

	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT obj = sel.selected_objects[i];

		// blockout_object_scale(
		// 	sel.selected_objects[i],
		// 	sel.selected_face,
		// 	face_tool_magnitude
		// );

		editor_push_op_vec(obj, OPTYPE.SCALE, sel.selected_face, face_tool_magnitude, sel.selected_objects_count);

		blockout_reload_object(obj);
	}

}


/////////////////////////////////////
// Rotate Tool
/////////////////////////////////////

// 5 degrees as radians
const float D2R_1_DEG = ((1.0f * MATH_PI) / 180.0f);
const float D2R_5_DEG = ((5.0f * MATH_PI) / 180.0f);
const float D2R_15_DEG = ((15.0f * MATH_PI) / 180.0f);
const float D2R_45_DEG = ((45.0f * MATH_PI) / 180.0f);
const float D2R_90_DEG = ((90.0f * MATH_PI) / 180.0f);

float editor_get_rotate_snap_value()
{
	float[4] snap_values = { D2R_1_DEG, D2R_5_DEG, D2R_15_DEG, D2R_45_DEG };
	uint index = fclamp(editor_snap_level, 0, 3);
	return snap_values[index];
}

/* If snap is enabled, this snaps a given angle vector (radians) to the selected rotation snap increment. */
float3 editor_rotate_snap(float3 vec)
{
	if (!editor_enable_snap) {
		return vec;
	}

	float3 qsnap = float3(editor_get_rotate_snap_value());
	return (float3_round(vec / qsnap) * qsnap);
}

/* How many radians one metre of sideways drag equates to */
const float ROTATE_SENSITIVITY = D2R_90_DEG;

@private
void editor_rotate_selection(float3 rotation_delta)
{
	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT obj = sel.selected_objects[i];
		float3 initial_rotation = sel.initial_object_rotations[i];

		obj.rotate_to(initial_rotation + rotation_delta);
	}
}

@private
void editor_rotate_tool(float delta_time)
{
	if (!editor_has_object_selection()) {
		return;
	}

	float3 player_delta = player.position - initial_player_position;
	float yaw = player_delta.x * ROTATE_SENSITIVITY;

	const float pitch_speed = delta_time * (editor_get_rotate_snap_value() * 4.0f);

	if (KEY.K_Q.is_down()) {
		rotate_pitch_accum -= pitch_speed;
	}
	if (KEY.K_E.is_down()) {
		rotate_pitch_accum += pitch_speed;
	}

	float3 rotation_movement = float3(rotate_pitch_accum, yaw, 0.0f);
	float3 rotation_delta = editor_rotate_snap(rotation_movement);

	editor_rotate_selection(rotation_delta);
}


@private
void editor_rotate_tool_finalize()
{
	// Skip clicks without any rotation
	int movers = 0;
	for (int i = 0; i < sel.selected_objects_count; i++) {
		if (!editor_vec_equal(sel.initial_object_rotations[i], sel.selected_objects[i].get_rotation())) {
			movers++;
		}
	}

	if (movers == 0) {
		return;
	}

	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT obj = sel.selected_objects[i];

		float3 initial_rotation = sel.initial_object_rotations[i];
		float3 current_rotation = obj.get_rotation();

		if (editor_vec_equal(initial_rotation, current_rotation)) {
			continue;
		}

		editor_push_op_vec(obj, OPTYPE.ROTATE, initial_rotation, current_rotation, movers);
	}
}


/////////////////////////////////////
// Editor Dispatch
/////////////////////////////////////

@private
void editor_handle_operation(float delta_time)
{
	if (editor_tool == EDITORTOOL.TRANSLATE) {
		editor_translate_tool(delta_time);
		return;
	}
	if (editor_tool == EDITORTOOL.FACE) {
		editor_face_tool(delta_time);
		return;
	}
	if (editor_tool == EDITORTOOL.ROTATE) {
		editor_rotate_tool(delta_time);
		return;
	}
}


@private
void editor_finalize_operation()
{
	/* Finalize the scale operation */
	if (editor_tool == EDITORTOOL.FACE) {
		editor_face_tool_finalize();
	}
	else if (editor_tool == EDITORTOOL.TRANSLATE) {
		editor_translate_tool_finalize();
	}
	else if (editor_tool == EDITORTOOL.ROTATE) {
		editor_rotate_tool_finalize();
	}
}



/////////////////////////////////////
// Interface Functions
/////////////////////////////////////

/* Called when switching into the editor mode */
void mode_load()
{
	reset_selection();

	// Should default to translate when switching to editor mode
	set_editor_tool(EDITORTOOL.TRANSLATE);

	player_had_headbob = cvar_get_bool("b_headbob_enabled", false);
}

/* Called when switching out of editor mode */
void mode_unload()
{
	reset_selection();
	hide_transform_marker_object();

	editor_disable_movement_damp();

	cvar_set_string("s_editor_op", "None");

	GUI_set_editor_tool(EDITORTOOL.NONE);
}

void editor_set_transform_marker(OBJECT xform_marker)
{
	transform_marker_object = xform_marker;
}


void mode_update(float3 movement_vector, float delta_time)
{
	editor_handle_controls();

	if (mouse_was_in_drag_event && !mouse_is_dragging) {
		editor_finalize_operation();
	}

	/* Mouse is no longer down, do not perform any operations */
	if (!editor_has_object_selection() || !mouse_is_dragging) {
		editor_disable_movement_damp();
		mouse_was_in_drag_event = false;
		return;
	}

	editor_enable_movement_damp();

	if (mouse_was_in_drag_event == false) {
		editor_on_mouse_just_down();
	}

	editor_handle_operation(delta_time);
}


/////////////////////////////////////
// Commands
/////////////////////////////////////


/* Snap selected object to world (undoable: pushes one Move op per moved object). */
void CMD_snap2w()
{
	if (!editor_has_object_selection()) {
		return;
	}

	int count = sel.selected_objects_count;

	int snaps = 0;
	for (int i = 0; i < count; i++) {
		OBJECT obj = sel.selected_objects[i];
		if (!editor_vec_equal(obj.position, editor_transform_snap(obj.position))) {
			snaps++;
		}
	}

	if (snaps == 0) {
		return;
	}

	// Snap all objects to world grid
	for (int i = 0; i < count; i++) {
		OBJECT obj = sel.selected_objects[i];
		float3 snapped = editor_transform_snap(obj.position);
		if (editor_vec_equal(obj.position, snapped)) {
			continue;
		}
		editor_push_op_vec(obj, OPTYPE.MOVE, obj.position, snapped, snaps);
	}
}

/////////////////////////////////////
// Light probe volumes
/////////////////////////////////////

/* Marks or unmarks the selected brushes as probe volumes, and returns how many changed. */
int editor_mark_probe_volumes(bool enabled)
{
	if (!editor_has_object_selection()) {
		printf("probe volumes: nothing selected\n");
		return 0;
	}

	int changed = 0;

	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT obj = sel.selected_objects[i];

		if (probe_volume_is_marked(obj) == enabled) {
			continue;
		}

		probe_volume_mark(obj, enabled);
		changed++;
	}

	return changed;
}

/* Turn the selected brushes into probe volumes */
void CMD_probevol()
{
	int changed = editor_mark_probe_volumes(true);
	int total = probe_rebuild_volumes();

	printf("probe volumes: marked %d brush(es), %d now defined, %d probes\n", changed, total, probe_count());
}

/* Turn the selected probe volume brushes back into ordinary geometry. */
void CMD_probevolclear()
{
	int changed = editor_mark_probe_volumes(false);
	int total = probe_rebuild_volumes();

	printf("probe volumes: unmarked %d brush(es), %d still defined, %d probes\n", changed, total, probe_count());
}

/* Rebuild the volumes from the marked brushes without baking, to see where the probes land. */
void CMD_proberebuild()
{
	int total = probe_rebuild_volumes();

	printf("probe volumes: %d from brushes, %d volume(s), %d probes\n", total, probe_volume_count(), probe_count());
}

/* Rebuild the volumes and bake them. Runs a few probes per frame, so it takes a while on a big level. */
void CMD_probebake()
{
	if (probe_is_baking()) {
		printf("probe bake already running\n");
		return;
	}

	probe_bake();
}

/* Save the baked probes for this scene. They are loaded automatically on the next run. */
void CMD_probesave()
{
	if (probe_is_baking()) {
		printf("cannot save while the probes are baking\n");
		return;
	}

	if (probe_save()) {
		printf("probes saved\n");
	}
}

void CMD_lock()
{
	if (!editor_has_object_selection()) {
		return;
	}

	int snaps = 0;
	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT obj = sel.selected_objects[i];
		obj.set_tags(obj.get_tags() | OBJ_TAG_LOCK);
	}
}
