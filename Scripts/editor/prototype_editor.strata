/*
 * File:        prototype_editor.strata
 * Author:      emd22
 * Created:     09/09/2026
 * Description: Entry point for the in-game editor. Owns the hotkeys, the drag lifecycle and the editor mode
 *              interface called from C++, and runs the tool that is selected in the GUI editor.
 *
 *              The tools themselves live in `tools/tool_*.strata`, and the state they share in `tool_common.strata`.
 *              Each tool provides `tool_<name>_begin` (mouse pressed), `tool_<name>_update` (every frame of the drag)
 *              and `tool_<name>_finalize` (mouse released), and this file dispatches to them by `editor_tool`.
 */

import ../interop;
import ../common;
import ../keyboard;

import tool_common;
import tools/tool_translate;
import tools/tool_face;
import tools/tool_rotate;
import tools/tool_create;
import tools/tool_clip;
import tools/tool_set_material;


/////////////////////////////////////
// Globals
/////////////////////////////////////

bool mouse_is_dragging = false;
bool mouse_was_in_drag_event = false;

bool player_had_headbob = false;


/////////////////////////////////////
// Editor tool selection
/////////////////////////////////////

/* Called by the GUI editor when its selected tool changes. */
void __set_editor_tool(EDITORTOOL tool)
{
	editor_tool = tool;
}

void set_editor_tool(EDITORTOOL tool)
{
	GUI_set_editor_tool(tool);
	// __set_editor_tool() is called by the GUI editor
}

/* Create and Set Material work on whatever the crosshair is on, the other tools on the selection */
@private
bool editor_tool_needs_selection()
{
	return (editor_tool != EDITORTOOL.CREATE && editor_tool != EDITORTOOL.SET_MATERIAL);
}


/////////////////////////////////////
// Controls
/////////////////////////////////////

@private
void editor_handle_controls()
{
	if (KEY.K_U.is_pressed()) {
		editor_enable_snap = !editor_enable_snap;
	}

	if (KEY.K_MINUS.is_pressed()) {
		editor_adjust_snap_index(-1);
	}
	if (KEY.K_EQUALS.is_pressed()) {
		editor_adjust_snap_index(1);
	}

	const bool not_in_xform_operation = (!mouse_is_dragging);

	/* Do not allow changing modes (or creating new objects) while actively doing an editor task */
	if (not_in_xform_operation) {
		/* Create a new blockout object */
		if (KEY.K_K.is_pressed()) {
			float3 origin = editor_transform_snap(player.ray_get_point(20.0f));
			// OBJECT new_obj = blockout_new_object(editor_transform_snap(origin));

			OBJECT new_obj = editor_op_create_object(origin, 1);

			editor_select_object(new_obj, true, false);
		}

		/* Transform type selectors */

		/* Translate (Move) */
		if (KEY.K_T.is_pressed()) {
			set_editor_tool(EDITORTOOL.TRANSLATE);
		}

		/* Face (Scale) */
		if (KEY.K_F.is_pressed()) {
			set_editor_tool(EDITORTOOL.FACE);
		}

		/* Rotate. Excludes LSHIFT so this doesn't also fire on the C++ side's Shift+R (reload blockout). */
		if (KEY.K_R.is_pressed() && !KEY.K_LSHIFT.is_down()) {
			set_editor_tool(EDITORTOOL.ROTATE);
		}

		/* Create (draw a new brush) */
		if (KEY.K_B.is_pressed()) {
			set_editor_tool(EDITORTOOL.CREATE);
		}

		/* Clip (split a brush) */
		if (KEY.K_C.is_pressed()) {
			set_editor_tool(EDITORTOOL.CLIP);
		}

		/* Set Material (paint faces) */
		if (KEY.K_V.is_pressed()) {
			set_editor_tool(EDITORTOOL.SET_MATERIAL);
		}
	}

	/* Per-tool hotkeys that are not part of a drag */
	if (not_in_xform_operation) {
		if (editor_tool == EDITORTOOL.FACE) {
			tool_face_controls();
		}
		else if (editor_tool == EDITORTOOL.SET_MATERIAL) {
			tool_set_material_controls();
		}
	}

	/* Non-manipulation, but object functions. */
	if (editor_has_object_selection()) {
		/* Destroy/Remove an object */
		if (KEY.K_BACKSPACE.is_pressed()) {
			editor_destroy_selection();
		}

		/* Dupe object on LCTRL + D */
		if (KEY.K_D.is_lctrl_combo()) {
			editor_dupe_selection();
		}

	}


	mouse_is_dragging = KEY.K_MOUSE_LEFT.is_down();
}


/* Player movement dampening */

void editor_enable_movement_damp()
{
	player.set_speed_multiplier(0.5f);
	cvar_set_bool("b_headbob_enabled", false);
}

void editor_disable_movement_damp()
{
	player.set_speed_multiplier(1.0f);
	cvar_set_bool("b_headbob_enabled", player_had_headbob);
}


/////////////////////////////////////
// Tool Dispatch
/////////////////////////////////////

/* The mouse button was pressed with no ongoing mouse down event. */
@private
void editor_on_mouse_just_down()
{
	initial_player_position = player.position;

	for (int i = 0; i < sel.selected_objects_count; i++) {
		sel.initial_object_positions[i] = sel.selected_objects[i].position;
		sel.initial_object_rotations[i] = sel.selected_objects[i].get_rotation();
	}

	// initial_object_position = sel.selected_object.position;
	mouse_was_in_drag_event = true;

	if (editor_tool == EDITORTOOL.TRANSLATE) {
		tool_translate_begin();
	}
	else if (editor_tool == EDITORTOOL.FACE) {
		tool_face_begin();
	}
	else if (editor_tool == EDITORTOOL.ROTATE) {
		tool_rotate_begin();
	}
	else if (editor_tool == EDITORTOOL.CREATE) {
		tool_create_begin();
	}
	else if (editor_tool == EDITORTOOL.CLIP) {
		tool_clip_begin();
	}
	else if (editor_tool == EDITORTOOL.SET_MATERIAL) {
		tool_set_material_begin();
	}
}

@private
void editor_handle_operation(float delta_time)
{
	if (editor_tool == EDITORTOOL.TRANSLATE) {
		tool_translate_update(delta_time);
	}
	else if (editor_tool == EDITORTOOL.FACE) {
		tool_face_update(delta_time);
	}
	else if (editor_tool == EDITORTOOL.ROTATE) {
		tool_rotate_update(delta_time);
	}
	else if (editor_tool == EDITORTOOL.CREATE) {
		tool_create_update(delta_time);
	}
	else if (editor_tool == EDITORTOOL.CLIP) {
		tool_clip_update(delta_time);
	}
}


@private
void editor_finalize_operation()
{
	if (editor_tool == EDITORTOOL.TRANSLATE) {
		tool_translate_finalize();
	}
	else if (editor_tool == EDITORTOOL.FACE) {
		tool_face_finalize();
	}
	else if (editor_tool == EDITORTOOL.ROTATE) {
		tool_rotate_finalize();
	}
	else if (editor_tool == EDITORTOOL.CREATE) {
		tool_create_finalize();
	}
	else if (editor_tool == EDITORTOOL.CLIP) {
		tool_clip_finalize();
	}
}



/////////////////////////////////////
// Interface Functions
/////////////////////////////////////

/* Called when switching into the editor mode */
void mode_load()
{
	reset_selection();

	// Should default to translate when switching to editor mode
	set_editor_tool(EDITORTOOL.TRANSLATE);

	player_had_headbob = cvar_get_bool("b_headbob_enabled", false);
}

/* Called when switching out of editor mode */
void mode_unload()
{
	reset_selection();
	hide_transform_marker_object();

	editor_disable_movement_damp();

	cvar_set_string("s_editor_op", "None");

	GUI_set_editor_tool(EDITORTOOL.NONE);
}

void editor_set_transform_marker(OBJECT xform_marker)
{
	transform_marker_object = xform_marker;
}


void mode_update(float3 movement_vector, float delta_time)
{
	editor_handle_controls();

	if (mouse_was_in_drag_event && !mouse_is_dragging) {
		editor_finalize_operation();
	}

	bool needs_selection = editor_tool_needs_selection();

	/* Mouse is no longer down, do not perform any operations */
	if ((needs_selection && !editor_has_object_selection()) || !mouse_is_dragging) {
		editor_disable_movement_damp();
		mouse_was_in_drag_event = false;
		return;
	}

	editor_enable_movement_damp();

	if (mouse_was_in_drag_event == false) {
		editor_on_mouse_just_down();
	}

	editor_handle_operation(delta_time);
}


/////////////////////////////////////
// Commands
/////////////////////////////////////


/* Snap selected object to world (undoable: pushes one Move op per moved object). */
void CMD_snap2w()
{
	if (!editor_has_object_selection()) {
		return;
	}

	int count = sel.selected_objects_count;

	int snaps = 0;
	for (int i = 0; i < count; i++) {
		OBJECT obj = sel.selected_objects[i];
		if (!editor_vec_equal(obj.position, editor_transform_snap(obj.position))) {
			snaps++;
		}
	}

	if (snaps == 0) {
		return;
	}

	// Snap all objects to world grid
	for (int i = 0; i < count; i++) {
		OBJECT obj = sel.selected_objects[i];
		float3 snapped = editor_transform_snap(obj.position);
		if (editor_vec_equal(obj.position, snapped)) {
			continue;
		}
		editor_push_op_vec(obj, OPTYPE.MOVE, obj.position, snapped, snaps);
	}
}

/////////////////////////////////////
// Light probe volumes
/////////////////////////////////////

/* Marks or unmarks the selected brushes as probe volumes, and returns how many changed. */
int editor_mark_probe_volumes(bool enabled)
{
	if (!editor_has_object_selection()) {
		printf("probe volumes: nothing selected\n");
		return 0;
	}

	int changed = 0;

	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT obj = sel.selected_objects[i];

		if (probe_volume_is_marked(obj) == enabled) {
			continue;
		}

		probe_volume_mark(obj, enabled);
		changed++;
	}

	return changed;
}

/* Turn the selected brushes into probe volumes */
void CMD_probevol()
{
	int changed = editor_mark_probe_volumes(true);
	int total = probe_rebuild_volumes();

	printf("probe volumes: marked %d brush(es), %d now defined, %d probes\n", changed, total, probe_count());
}

/* Turn the selected probe volume brushes back into ordinary geometry. */
void CMD_probevolclear()
{
	int changed = editor_mark_probe_volumes(false);
	int total = probe_rebuild_volumes();

	printf("probe volumes: unmarked %d brush(es), %d still defined, %d probes\n", changed, total, probe_count());
}

/* Rebuild the volumes from the marked brushes without baking, to see where the probes land. */
void CMD_proberebuild()
{
	int total = probe_rebuild_volumes();

	printf("probe volumes: %d from brushes, %d volume(s), %d probes\n", total, probe_volume_count(), probe_count());
}

/* Rebuild the volumes and bake them. Runs a few probes per frame, so it takes a while on a big level. */
void CMD_probebake()
{
	if (probe_is_baking()) {
		printf("probe bake already running\n");
		return;
	}

	probe_bake();
}

/* Save the baked probes for this scene. They are loaded automatically on the next run. */
void CMD_probesave()
{
	if (probe_is_baking()) {
		printf("cannot save while the probes are baking\n");
		return;
	}

	if (probe_save()) {
		printf("probes saved\n");
	}
}

void CMD_lock()
{
	if (!editor_has_object_selection()) {
		return;
	}

	int snaps = 0;
	for (int i = 0; i < sel.selected_objects_count; i++) {
		OBJECT obj = sel.selected_objects[i];
		obj.set_tags(obj.get_tags() | OBJ_TAG_LOCK);
	}
}
