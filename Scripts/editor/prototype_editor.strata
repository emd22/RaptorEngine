/*
 * File:        prototype_editor.strata
 * Author:      emd22
 * Created:     09/09/2026
 * Description: This script serves as a one-stop shop for all object transformations in-game.
 */

import ../interop;
import ../common;
import ../keyboard;


enum OBJECTTAG
{
	BLOCKOUT = (1 << 0),
}

enum XFORMTYPE
{
	TRANSLATE = 0,
	FACE = 1,
}

struct SELECTION
{
	/* Is there nothing selected? */
	bool is_object_selected;

	/* The currently selected object (via raycast) */
	OBJECT selected_object;

	/* Selected cube face (for FACE mode) */

	float3 selected_face;
	float selected_face_scale;
};

/////////////////////////////////////
// Globals
/////////////////////////////////////

float3 initial_player_position;
float3 camera_distance;
bool mouse_is_dragging = false;
bool mouse_was_in_drag_event = false;

/* snap */
int editor_snap_level = 2;
bool editor_enable_snap = true;

bool player_had_headbob = false;

/* Cube marker used for showing distance and movement when transforming an object.
   Used mainly with scale/face tool. */
OBJECT transform_marker_object;

SELECTION editor_selection;

float3 face_tool_magnitude;

XFORMTYPE transform_type = XFORMTYPE.TRANSLATE;


/////////////////////////////////////
// Editor functions
/////////////////////////////////////

@private
void reset_selection()
{
	editor_selection.is_object_selected = false;
	editor_selection.selected_face = float3(0.0f);
	editor_selection.selected_face_scale = 0.0f;
}

void hide_transform_marker_object()
{
	/* Move the transform marker to a location where the user won't see it... */
	transform_marker_object.move_to(float3(200.0f));
}

/* Adjust the step size of the snap. negative (-1) decreases the size of each step,
   positive (1) increases it. */
@private
void editor_adjust_snap_index(int direction)
{
	if (direction < 0) {
		editor_snap_level--;
	}
	else {
		editor_snap_level++;
	}

	editor_snap_level = fclamp(editor_snap_level, 0, 3);
}


/* Select an object. Passing in false for `is_selected` acts as a null value, voiding the selection. */
void editor_select_object(OBJECT object, bool is_selected)
{
	editor_selection.is_object_selected = is_selected;
	editor_selection.selected_object = object;
}

@private
void editor_handle_controls()
{
	if (KEY.K_U.is_pressed()) {
		editor_enable_snap = !editor_enable_snap;
	}

	if (KEY.K_MINUS.is_pressed()) {
		editor_adjust_snap_index(-1);
	}
	if (KEY.K_EQUALS.is_pressed()) {
		editor_adjust_snap_index(1);
	}

	const bool not_in_xform_operation = (!mouse_is_dragging);

	/* Do not allow changing modes (or creating new objects) while actively doing an editor task */
	if (not_in_xform_operation) {
		/* Create a new blockout object */
		if (KEY.K_K.is_pressed()) {
			float3 origin = player.ray_get_point(20.0f);
			OBJECT new_obj = blockout_new_object(origin);
			editor_select_object(new_obj, true);
		}

		/* Transform type selectors */

		/* Translate (Move) */
		if (KEY.K_T.is_pressed()) {
			transform_type = XFORMTYPE.TRANSLATE;
		}

		/* Face (Scale) */
		if (KEY.K_F.is_pressed()) {
			transform_type = XFORMTYPE.FACE;
		}
	}

	mouse_is_dragging = KEY.K_MOUSE_LEFT.is_down();
}


/* Get the division that we are quantizing by. NOTE: not the index. */
float editor_get_snap_value()
{
	float[4] snap_values = { 0.05f, 0.10f, 0.25f, 0.50f };
	uint index = fclamp(editor_snap_level, 0, 3);
	return snap_values[index];
}

/* If snap is enabled, this snaps a given vector to the selected snap fraction. */
float3 editor_transform_snap(float3 vec)
{
	if (!editor_enable_snap) {
		return vec;
	}

	float3 qsnap = float3(editor_get_snap_value());
	return (float3_round(vec / qsnap) * qsnap);
}


/* Player movement dampening */

void editor_enable_movement_damp()
{
	player.set_speed_multiplier(0.5f);
	player.toggle_headbob(false);
}

void editor_disable_movement_damp()
{
	player.set_speed_multiplier(1.0f);
	player.toggle_headbob(player_had_headbob);
}


/* The mouse button was pressed with no ongoing mouse down event. */
void editor_on_mouse_just_down()
{
	initial_player_position = player.position;
	camera_distance = editor_selection.selected_object.position - initial_player_position;
	mouse_was_in_drag_event = true;

	if (transform_type == XFORMTYPE.FACE) {
		/* Cast and gather the face we are pointing towards */
		float3 selected_face = editor_selection.selected_object.ray_get_face();

		editor_selection.selected_face = selected_face;
		editor_selection.selected_face_scale = editor_selection.selected_object.direction_scale(selected_face);
	}
}


/////////////////////////////////////
// Translate Tool
/////////////////////////////////////

/* Translate an object */
@private
void editor_translate_tool(float delta_time)
{
	float3 translate_movement = player.position + camera_distance;

	/* We are not in fly mode, handle Z movement manually */
	if (!player.is_flymode()) {
		const float speed = delta_time * 2.0f;

		if (KEY.K_Q.is_down()) {
			float3 move_direction = float3(0.0f, -speed, 0.0f);
			translate_movement += move_direction;
			camera_distance += move_direction;
		}
		if (KEY.K_E.is_down()) {
			float3 move_direction = float3(0.0f, speed, 0.0f);
			translate_movement += move_direction;
			camera_distance += move_direction;
		}
	}

	editor_selection.selected_object.move_to(editor_transform_snap(translate_movement));
}

/////////////////////////////////////
// Face Tool
/////////////////////////////////////

enum FACEDIR
{
	X = 0,
	Y = 1,
	Z = 2,
};

@private
FACEDIR face_get_dir()
{
	float3 abs_face = float3_abs(editor_selection.selected_face);

	const float threshold = 0.01f;

	if (abs_face.x > threshold) {
		return FACEDIR.X;
	}
	if (abs_face.y > threshold) {
		return FACEDIR.Y;
	}

	return FACEDIR.Z;
}

@private
void editor_face_tool(float delta_time)
{
	FACEDIR direction = face_get_dir();

	face_tool_magnitude = (player.position - initial_player_position) * editor_selection.selected_face;

	float3 player_pos = player.position;

	float3 destination_position = editor_transform_snap(player_pos + camera_distance);
	float3 camera_pos = camera_position();

	if (direction == FACEDIR.X) {
		destination_position.y = camera_pos.y;
		destination_position.z = player_pos.z;
	}
	else if (direction == FACEDIR.Y) {
		destination_position.x = player_pos.x;
		destination_position.z = player_pos.z;
	}
	else if (direction == FACEDIR.Z) {
		destination_position.y = camera_pos.y;
		destination_position.x = player_pos.x;
	}

	/* Calculate the position for the transform marker */
	float3 xform_marker_dest = (destination_position + (editor_selection.selected_face * float3(editor_selection.selected_face_scale)));
	transform_marker_object.move_to(xform_marker_dest);
}

@private
void editor_face_tool_finalize()
{
	blockout_object_scale(
		editor_selection.selected_object,
		editor_selection.selected_face,
		face_tool_magnitude
	);

	if (editor_selection.is_object_selected) {
		blockout_reload_object(editor_selection.selected_object);
	}

	hide_transform_marker_object();
}


/////////////////////////////////////
// Editor Dispatch
/////////////////////////////////////

@private
void editor_handle_operation(float delta_time)
{
	if (transform_type == XFORMTYPE.TRANSLATE) {
		editor_translate_tool(delta_time);
		return;
	}
	if (transform_type == XFORMTYPE.FACE) {
		editor_face_tool(delta_time);
		return;
	}
}


@private
void editor_finalize_operation()
{
	/* Finalize the scale operation */
	if (transform_type == XFORMTYPE.FACE) {
		editor_face_tool_finalize();
	}
}



/////////////////////////////////////
// Interface Functions
/////////////////////////////////////

/* Called when switching into the editor mode */
void mode_load()
{
	camera_distance = float3(0.0f);
	reset_selection();

	player_had_headbob = player.get_headbob();
}

/* Called when switching out of editor mode */
void mode_unload()
{
	reset_selection();
	hide_transform_marker_object();

	editor_disable_movement_damp();
}

void editor_set_transform_marker(OBJECT xform_marker)
{
	transform_marker_object = xform_marker;
}


void mode_update(float3 movement_vector, float delta_time)
{
	editor_handle_controls();

	if (mouse_was_in_drag_event && !mouse_is_dragging) {
		editor_finalize_operation();
	}

	/* Mouse is no longer down, do not perform any operations */
	if (!editor_selection.is_object_selected || !mouse_is_dragging) {
		editor_disable_movement_damp();
		mouse_was_in_drag_event = false;
		return;
	}

	editor_enable_movement_damp();

	if (mouse_was_in_drag_event == false) {
		editor_on_mouse_just_down();
	}

	editor_handle_operation(delta_time);
}
