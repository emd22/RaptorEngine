void CMD_lock()
{
	if (!editor_has_object_selection()) {
		return;
	}

	for (int i = 0; i < sel.selected_objects_count; i++) {
		RObject obj = sel.selected_objects[i];
		obj.SetTags((RObjectTags)((uint)obj.GetTags() | (uint)RObjectTags.Lock));
	}
}
