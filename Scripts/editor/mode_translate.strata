import mode_common;

OBJECT selected_object;

void mode_load()
{

}

void mode_select_object(OBJECT object)
{
	selected_object = object;
}


void mode_update(float3 movement_vector)
{
	/* Only update if lmouse is pressed */
	if ((ctrl_mouse_state() & CTRL_LMOUSE) == 0) {
		return;
	}

	float3 tmp = movement_vector * float3(0.1);

	object_move_by(selected_object, tmp);
}


void mode_unload()
{
}
