import ../common;
import ../keyboard;

import mode_common;

// Globals

float3 camera_dist;
bool was_in_drag_event = false;

void mode_load()
{
	camera_dist = float3(0.0f);

}

void mode_select_object(OBJECT object, bool selected)
{
	is_object_selected = selected;
	selected_object = object;
}

void mode_update(float3 movement_vector, float delta_time)
{
	mode_common_controls();

	bool is_dragging = KEY.K_MOUSE_LEFT.is_down();

	/* Only update if lmouse is pressed and a valid object is selected */
	if (!is_object_selected || !is_dragging) {
		mode_common_disable_damp();
		was_in_drag_event = false;
		return;
	}

	mode_common_enable_damp();

	if (was_in_drag_event == false) {
		camera_dist = selected_object.position - player.position;
		was_in_drag_event = true;
	}


	float3 movement_final = player.position + camera_dist;

	// Only handle if the player is not in flymode. Otherwise, it is handled implicitly by the player's Y movement.
	if (!player.is_flymode()) {
		const float speed = delta_time * 2.0f;
		if (KEY.K_Q.is_down()) {
			float3 tmove = float3(0.0f, -speed, 0.0f);
			movement_final += tmove;
			camera_dist += tmove;
		}
		if (KEY.K_E.is_down()) {
			float3 tmove = float3(0.0f, speed, 0.0f);
			movement_final += tmove;
			camera_dist += tmove;
		}
	}

	float3 new_position = mode_common_quantize3(movement_final);


	selected_object.move_to(new_position);
}


void mode_unload()
{
	mode_common_unload();
}
