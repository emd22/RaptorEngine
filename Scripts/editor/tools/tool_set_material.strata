/*
 * File:        tool_set_material.strata
 * Author:      emd22
 * Created:     09/23/2026
 * Description: Set Material tool (paint faces). Run by `prototype_editor.strata` while EDITORTOOL.SET_MATERIAL is
 *              selected. Like Create it works on whatever the crosshair is on, not on the selection.
 */

import ../tool_common;


/* The prototype material slot (see eCProtoMat) that faces are painted with, or -1 for the blockout's own material */
int paint_material_slot = 0;

/* The last prototype material slot */
const int PAINT_MATERIAL_LAST_SLOT = 3;


@private
void tool_set_material_print()
{
	if (paint_material_slot == 0) {
		printf("paint material: grey\n");
	}
	else if (paint_material_slot == 1) {
		printf("paint material: orange\n");
	}
	else if (paint_material_slot == 2) {
		printf("paint material: blue\n");
	}
	else if (paint_material_slot == 3) {
		printf("paint material: tile\n");
	}
	else {
		printf("paint material: the brush's own material\n");
	}
}

/* Paint the face under the crosshair on mouse down. Shift paints every face of the brush. */
void tool_set_material_begin()
{
	blockout_paint_material(paint_material_slot, KEY.K_LSHIFT.is_down());
}

/* [ and ] step through the materials to paint with: the brush's own material, then each prototype material.
   Called every frame the Set Material tool is selected and no drag is in progress. */
void tool_set_material_controls()
{
	/* Painted faces would be hidden under the selection highlight */
	if (editor_has_object_selection()) {
		reset_selection();
	}

	if (KEY.K_LBRACKET.is_pressed()) {
		paint_material_slot--;

		if (paint_material_slot < -1) {
			paint_material_slot = PAINT_MATERIAL_LAST_SLOT;
		}

		tool_set_material_print();
	}
	if (KEY.K_RBRACKET.is_pressed()) {
		paint_material_slot++;

		if (paint_material_slot > PAINT_MATERIAL_LAST_SLOT) {
			paint_material_slot = -1;
		}

		tool_set_material_print();
	}
}
