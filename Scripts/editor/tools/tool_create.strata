/*
 * File:        tool_create.strata
 * Author:      emd22
 * Created:     23/09/2026
 * Description: Create tool (draw a new brush). Unlike the other tools it works on whatever the crosshair is on, not on
 *              the selection.
 */

import ../tool_common;


const float CREATE_RANGE = 100.0f;

const float CREATE_DEFAULT_HEIGHT = 1.0f;

bool create_active = false;

float3 create_surface;
float3 create_start;
float3 create_normal;
float create_height;
float3 create_min;
float3 create_max;


/* The world axis closest to `v`, keeping its sign */
@private
float3 tool_create_dominant_axis(float3 v)
{
	float3 a = float3_abs(v);

	if (a.y >= a.x && a.y >= a.z) {
		return float3(0.0f, float_sign(v.y), 0.0f);
	}
	if (a.x >= a.z) {
		return float3(float_sign(v.x), 0.0f, 0.0f);
	}

	return float3(0.0f, 0.0f, float_sign(v.z));
}

@private
float3 tool_create_cell()
{
	float3 point = camera_ray_to_plane(create_surface, create_normal);

	if (editor_get_snap_enabled()) {
		float3 step = float3(tool_get_snap_multiplier());
		point = float3_floor(point / step) * step;
	}

	/* Along the normal it stays exactly on the surface */
	float3 axis_mask = float3_abs(create_normal);
	return (point * (float3(1.0f) - axis_mask)) + (create_surface * axis_mask);
}

void tool_begin()
{
	float3 normal = player.ray_get_normal(CREATE_RANGE);

	create_active = !nearzero(normal);

	if (!create_active) {
		return;
	}

	create_normal = tool_create_dominant_axis(normal);

	float3 hit = player.ray_get_point(CREATE_RANGE);
	float3 snapped = editor_transform_snap(hit);

	if (dot(float3_abs(snapped - hit), float3_abs(create_normal)) < 0.001f) {
		hit = snapped;
	}

	create_surface = hit;
	create_start = tool_create_cell();
	create_height = CREATE_DEFAULT_HEIGHT;
}

void tool_update(float delta_time)
{
	if (!create_active) {
		return;
	}

	float step = tool_get_snap_multiplier();

	if (KEY.K_E.is_pressed()) {
		create_height += step;
	}
	if (KEY.K_Q.is_pressed()) {
		create_height = fmax(step, create_height - step);
	}

	float3 plane_mask = float3(1.0f) - float3_abs(create_normal);

	/* Both cells are low corners, so the far side of the brush is a cell further along the plane */
	float3 cell_size = float3(0.0f);
	if (editor_get_snap_enabled()) {
		cell_size = plane_mask * float3(step);
	}

	float3 corner = tool_create_cell();
	float3 top = create_start + (create_normal * float3(create_height));

	float3 lo = float3(fmin(create_start.x, fmin(corner.x, top.x)), fmin(create_start.y, fmin(corner.y, top.y)),
					   fmin(create_start.z, fmin(corner.z, top.z)));
	float3 hi = float3(fmax(create_start.x, corner.x), fmax(create_start.y, corner.y), fmax(create_start.z, corner.z));
	hi = hi + cell_size;
	hi = float3(fmax(hi.x, top.x), fmax(hi.y, top.y), fmax(hi.z, top.z));

	/* Without snapping there are no cells, so a click without a drag still needs a minimum size to make a brush */
	hi = float3(fmax(hi.x, lo.x + step), fmax(hi.y, lo.y + step), fmax(hi.z, lo.z + step));

	create_min = lo;
	create_max = hi;

	blockout_preview_box(create_min, create_max);
}

void tool_finalize()
{
	blockout_hide_preview();

	if (!create_active) {
		return;
	}

	create_active = false;

	OBJECT created = blockout_create_box(create_min, create_max);
	editor_select_object(created, true, false);
}
