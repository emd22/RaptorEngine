/*
 *	Common functions and externals for editor modes
 */


@export
extern int printf(string fmt, ...);

/* Must match eScriptOpType in Src/Script/ScriptInterop.cpp! Only MOVE, SCALE and ROTATE are pushed with editor_push_op_vec */
enum OPTYPE
{
	MOVE,
	SCALE,
	DUPE,
	CREATE,
	DELETE,
	ROTATE,
	BRUSH_EDIT,
	CREATE_BRUSH,
	LIGHT_TRANSFORM,
	LIGHT_CREATE,
	LIGHT_DELETE,
	OBJECT_STATE_EDIT,
	SPAWN_TRANSFORM,
	SCRIPT_EDIT,
	TRIGGER_DIRECTION_EDIT,
}

/* This must match eFaceTextureEdit in Blockout.hpp! */
enum FACETEXTUREEDIT : uint
{
	SHIFT,
	SCALE,
	ROTATE,
	RESET,
}

/* This must match eEditorTool in Src/Editor/EditorTool.hpp! */
enum EDITORTOOL
{
	SELECT,
	FACE,
	VERTEX,
	CREATE,
	ARCH,
	ROOM,
	CURVE,
	DECAL,
	ROTATE,
	CLIP,
	LIGHT,
	SOUND,
}


/*
	Math Util
 */

extern float float_sqrt(float value);

extern float4 float4_round(float4 value);
extern float4 float4_floor(float4 value);

float3 float3_floor(float3 value) { return (float4_floor(float4(value, 0.0f))).xyz; }


float3 float3_round(float3 value)
{
	float4 result = float4_round(float4(value, 0.0f));
	return result.xyz;
}

