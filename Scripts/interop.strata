/* Particles */

extern long particle_play(cstring name, float3 position, float3 direction);
extern void particle_move(long effect, float3 position, float3 direction);
extern void particle_stop(long effect);
extern void particle_kill(long effect);
extern bool particle_alive(long effect);

/* Sounds */

extern long sound_play(cstring name, float3 position);
extern long sound_play_2d(cstring name);
extern void sound_move(long sound, float3 position);
extern void sound_set_volume(long sound, float volume);
extern void sound_stop(long sound);
extern void sound_kill(long sound);
extern bool sound_alive(long sound);

/* Mix snapshots from Sounds/Mix/mix.conf. They are counted, so every start needs a matching stop. */
extern void sound_snapshot_start(cstring name);
extern void sound_snapshot_stop(cstring name);

/* Timers. Callbacks are looked up by name and have the signature `void fn(OBJECT self, long timer)`, where `self` is
 * null for scripts that are not attached to an object. A timer belongs to the script that started it, and stops when
 * that script is reloaded, detached or the object stops simulating. Timers only run while the game is simulating. */

/* Calls `fn` once, after `seconds`. */
extern long timer_after(float seconds, cstring fn);
/* Calls `fn` every `seconds` until it is cancelled. */
extern long timer_every(float seconds, cstring fn);
/* Calls `fn` `count` times, `seconds` apart. */
extern long timer_repeat(float seconds, int count, cstring fn);
/* Cancelling a timer that has already finished does nothing. */
extern void timer_cancel(long timer);
/* Cancels every timer started by the calling script. */
extern void timer_cancel_all();
extern bool timer_active(long timer);
/* Seconds until the timer fires next, or 0 if it is no longer active. */
extern float timer_remaining(long timer);
/* The game clock that timers are measured against, in seconds of simulation. */
extern float timer_clock();
/* Logs every active timer. */
extern void timer_list();

/* Portals */

extern bool portal_set_open(cstring name, bool open);
extern bool portal_is_open(cstring name);

/* NPC behaviours. An NPC is named by its handle, which is 0 for none. Behaviours are "fallen", "stagger", "shot",
 * "brace", "protect_head", "high_fall", "writhe" and "dying"; every behaviour has the settings "enabled", "priority",
 * "fade_in" and "fade_out" plus its own (npc_behaviour_list prints them). */

@export extern int npc_find(cstring name);
/* The NPC hit by the last weapon_hit_apply, or 0 if it missed. */
@export extern int npc_last_hit();
@export extern bool npc_is_alive(int npc);

/* Starts a behaviour. "dying" kills the NPC; "fallen", "writhe" and "high_fall" knock it down first. */

@export extern bool npc_behaviour_trigger(int npc, cstring behaviour);
@export extern bool npc_behaviour_stop(int npc, cstring behaviour);
@export extern bool npc_behaviour_active(int npc, cstring behaviour);

/* With npc 0 this changes the default for every NPC, including ones spawned later. */
@export extern bool npc_behaviour_set(int npc, cstring behaviour, cstring setting, float value);
@export extern float npc_behaviour_get(int npc, cstring behaviour, cstring setting);
@export extern void npc_behaviour_list(int npc);

/* NPC movement. Animated NPCs walk in a straight line (no path finding) and give up when blocked. States are 0 idle,
 * 1 walking to a point, 2 reacting to a hit or push, 3 fleeing. */

@export extern int npc_count();
/* The handle of the NPC at `index` (0 to npc_count() - 1), or 0 past the end. */
@export extern int npc_at(int index);
@export extern bool npc_walk_to(int npc, float3 target);
@export extern bool npc_flee(int npc, float3 from);
@export extern bool npc_idle(int npc);
@export extern int npc_brain_state(int npc);
/* Logs the active physics budget, physics time and each NPC's brain state. */
@export extern void npc_stats();

/* Spawning. The NPC model loads in the background: npc_spawn returns 0 until npc_model_ready returns true. A yaw of 0
 * faces +Z, and a yaw of `a` faces (sin a, 0, cos a). */

@export extern bool npc_model_ready();
@export extern int npc_spawn(float3 position, float yaw);
@export extern void npc_destroy(int npc);

/* Where the pelvis is in world space, which keeps following the NPC after it has fallen. */
@export extern float3 npc_position(int npc);
@export extern float3 npc_velocity(int npc);
@export extern float npc_health(int npc);

/* Must match N_npc_state in Src/Script/ScriptInterop.cpp! */
enum NPC_STATE
{
	GONE,
	STANDING,
	BALANCING,
	FALLEN,
	DYING,
	RAGDOLL,
}

@export extern NPC_STATE npc_state(int npc);

/* Physics props: dynamic boxes named by the value prop_spawn_box returns. A gravity_scale of 0 makes a prop float.
 * Props are removed once they get 50 m from the player, after which these calls do nothing. */

@export extern long prop_spawn_box(cstring material, float size, float mass, float gravity_scale, float3 position, float3 velocity);
/* Holds a prop at a velocity without letting contacts turn it. Call it every frame for a scripted mover. */
@export extern void prop_drive(long prop, float3 velocity);
@export extern float3 prop_position(long prop);
@export extern void prop_destroy(long prop);

/* CVars */

@export extern void cvar_set_int(cstring name, long value);
@export extern void cvar_set_float(cstring name, float value);
@export extern void cvar_set_string(cstring name, string value);

void cvar_set_bool(cstring name, bool value)
{
	cvar_set_int(name, (long)value);
}

@export extern float cvar_get_float(cstring name, float fallback);
@export extern long cvar_get_int(cstring name, long fallback);

bool cvar_get_bool(cstring name, bool fallback)
{
	return (bool)cvar_get_int(name, (long)fallback);
}


extern void script_error(cstring str);
