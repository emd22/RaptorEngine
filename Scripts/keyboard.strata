enum KEY : uint
{
	K_A = 4,
	K_B = 5,
	K_C = 6,
	K_D = 7,
	K_E = 8,
	K_F = 9,
	K_G = 10,
	K_H = 11,
	K_I = 12,
	K_J = 13,
	K_K = 14,
	K_L = 15,
	K_M = 16,
	K_N = 17,
	K_O = 18,
	K_P = 19,
	K_Q = 20,
	K_R = 21,
	K_S = 22,
	K_T = 23,
	K_U = 24,
	K_V = 25,
	K_W = 26,
	K_X = 27,
	K_Y = 28,
	K_Z = 29,

    K_MINUS = 45,
    K_EQUALS = 46,

	/* Left modifier keys */
    K_LCTRL = 100,
    K_LSHIFT = 101,
    K_LALT = 102,
    K_LMETA = 103,

    /* Right modifier keys */
    K_RCTRL = 104,
    K_RSHIFT = 105,
    K_RALT = 106,
    K_RMETA = 107,

    /* Mouse buttons */
    K_MOUSE_LEFT = 109,
    K_MOUSE_MIDDLE = 110,
    K_MOUSE_RIGHT = 111,
};

impl KEY
{
	extern bool is_up(KEY key);
	extern bool is_down(KEY key);
	extern bool is_pressed(KEY key);
}
