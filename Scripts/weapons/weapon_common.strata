import ../interop;

import ../math;

import std/math;

enum RWeaponPhase
{
	READY = 0,
	RELOADING,
	RAISING,
	LOWERING,
	LOWERED,
}

enum RWeaponMode
{
	SEMI = (1 << 0),
	AUTO = (1 << 1),
	BURST = (1 << 2),

	COUNT = 3,
}

enum RInputFlags
{
	FIRE_PRESSED = (1 << 0),
	FIRE_HELD = (1 << 1),
	RELOAD_PRESSED = (1 << 2),
	SWITCH_MODE = (1 << 3),
	SWITCH_WEAPON = (1 << 4),
	AIRBORNE = (1 << 5),
}

const float FIRE_BUFFER_TIME = 0.12f;

enum RWeaponEvent
{
	FIRE = 0,

	/* Out of ammo, does not actually fire. Tries to reload if there is ammo left in the ammo pool. */
	DRY_FIRE,

	RELOAD_BEGIN,
	RELOAD_END,

	RAISE,
	LOWER,

	MODE_CHANGED
}

struct RWeaponBurstDef
{
	int BurstCount;
	float RPM;
	float Cooldown;
}

struct RWeaponSpreadDef
{
	float Hip;
	float Moving;
	float Air;
	float PerShot;
	float Max;
	float Recovery;
}

struct RWeaponRecoilDef
{
	float Pitch;
	float PitchVariance;
	float Yaw;
	float Ramp;
	float RampMax;
	float Recovery;
	float ResetTime;
}

struct RWeaponFalloffDef
{
	float Start;
	float End;
	float Min;
}


@component
struct RWeaponDef
{
	float Damage;
	float Range;
	float RPM;
	int NumPellets;

	/* Flags for the supported weapon modes */
	RWeaponMode FireModes;
	RWeaponMode DefaultMode;

	RWeaponBurstDef Burst;

	float HitForce;
	int Decals;

	RWeaponSpreadDef Spread;

	RWeaponRecoilDef Recoil;
	RWeaponFalloffDef Falloff;

	/* Ammo properties */
	int MagSize;
	int ReserveMax;
	int ReserveStart;


	float ReloadTime;
	float ReloadTimeFromEmpty;
	int AutoReload;

	float RaiseTime;
	float LowerTime;
}

@component
struct RWeapon
{
	RWeaponPhase Phase;
	RWeaponMode FireMode;

	int Magazine;
	int Reserve;
	int BurstRemaining;
	int RecoilShots;

	float Timer;
	float TimerTotal;
	float Cooldown;
	float SinceShot;
	float Bloom;
	float FireBuffer;
}

@component
struct RWeaponInput
{
	RInputFlags Flags;
	float MoveAmount;
}



float GetWeaponInterval(float rounds_per_minute)
{
	return 60.0f / max<float>(rounds_per_minute, 1.0f);
}

float GetWeaponFalloff(ref RWeaponDef def, float dist)
{
	if (dist <= def.Falloff.Start) {
		return 1.0f;
	}
	if (dist >= def.Falloff.End) {
		return def.Falloff.Min;
	}

	float t = (dist - def.Falloff.Start) / (def.Falloff.End - def.Falloff.Start);
	return 1.0f + (def.Falloff.Min - 1.0f) * t;
}



float GetWeaponSpread(ref RWeaponDef def, ref RWeapon st, ref RWeaponInput inp)
{
	float spread = def.Spread.Hip + st.Bloom + def.Spread.Moving * clamp<float>(inp.MoveAmount, 0.0f, 1.0f);

	if (((uint)inp.Flags & (uint)RInputFlags.AIRBORNE) != 0) {
		spread += def.Spread.Air;
	}

	return spread;
}



impl RWeaponMode
{
	bool IsAllowed(RWeaponMode mode_flags, RWeaponMode mode)
	{
		return ((((uint)mode_flags) & ((uint)mode)) != 0);
	}

	/* Modes are bit flags, so this steps through bit indices (SEMI -> AUTO -> BURST -> SEMI) */
	RWeaponMode Next(RWeaponMode mode_flags, RWeaponMode current)
	{
		int current_bit = 0;

		for (int bit = 0; bit < (int)RWeaponMode.COUNT; bit++) {
			if ((int)current == (1 << bit)) {
				current_bit = bit;
			}
		}

		for (int i = 1; i <= (int)RWeaponMode.COUNT; i++) {
			RWeaponMode candidate = (RWeaponMode)(1 << ((current_bit + i) % (int)RWeaponMode.COUNT));

			if (RWeaponMode.IsAllowed(mode_flags, candidate)) {
				return candidate;
			}
		}

		return current;
	}
}
