

float fmin(float a, float b)
{
	if (a < b) {
		return a;
	}
	return b;
}

float fmax(float a, float b)
{
	if (a > b) {
		return a;
	}
	return b;
}

bool isapprox(float value, float expect, float tolerance)
{
	return (value <= (expect - tolerance) && value >= (expect + tolerance));
}

float fclamp(float value, float lo, float hi)
{
	if (value < lo) {
		return lo;
	}
	if (value > hi) {
		return hi;
	}

	return value;
}
